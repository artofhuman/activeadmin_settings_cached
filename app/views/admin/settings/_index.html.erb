<div>
  <%= semantic_form_for :settings, :method => :post, url: {action: :update} do |f| %>
    <table id="settings" class="index_table index">
      <thead>
        <tr>
          <th style="width: 30%"><%= t('settings.index.name')%></th>
          <th><%= t('settings.index.value')%></th>
        </tr>
      </thead>
      <% settings_model.fields_by_scope.each_pair do |scope, fields| %>
        <tbody>
          <% if scope %>
            <tr>
              <th colspan="2"><%= t("settings.scopes.#{scope}", default: scope.to_s.humanize) %></th>
            </tr>
          <% end %>
          <% fields.each do |field| %>
            <% key = field[:key] %>
            <tr class="odd">
              <td><strong><%= f.label key, t("settings.attributes.#{key}", default: key) %></strong></td>
              <td>
                <div class='form'>
                  <ol><%= f.input key, settings_model.field_options(key) %></ol>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </table>
    <%= f.submit %>
  <% end %>
</div>
